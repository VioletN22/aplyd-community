{
  // Type-checking for the half of the app `tsc -p tsconfig.json` never sees. Vite
  // transpiles the renderer without checking types, so before this file a broken
  // prop or a renamed IPC channel only showed up at runtime, in the packaged app.
  //
  // preload.ts is included on purpose: it declares window.electronAPI, so the
  // pages are checked against the real IPC surface rather than against `any`.
  // Emits nothing: the renderer's only build is Vite's.
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    // Deliberately looser than the main process for now: this check exists to
    // catch shape and contract mistakes, and turning strict on in the same pass
    // would bury those under several hundred null-check findings.
    "strict": false
  },
  "include": ["src/renderer/**/*", "src/shared/**/*", "src/vite-env.d.ts", "src/main/preload.ts"]
}
